# ==============================================================================
# OpenRouter Configuration for AI Complexity Analyzer
# ==============================================================================
# IMPORTANT: Keep your real API key in .env or .env.local (which is git-ignored).
# NEVER commit your real API key or expose it to client-side code.
# ==============================================================================

# Required: Your OpenRouter API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: OpenRouter Model ID (defaults to meta-llama/llama-3.3-70b-instruct:free or openai/gpt-4o-mini)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional OpenRouter request metadata
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=Online JS Compiler
